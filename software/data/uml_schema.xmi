      <packagedElement xmi:type="uml:Class" xmi:id="Class_TraceLink" name="TraceLink">
        <ownedAttribute xmi:type="uml:Property" xmi:id="Attr_TraceLink_traceId" name="traceId" type="PT_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Low_TraceLink_traceId" value="1" />
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Up_TraceLink_traceId" value="1" />
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="Attr_TraceLink_relationType" name="relationType" type="Enum_TraceRelationType">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Low_TraceLink_relationType" value="1" />
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Up_TraceLink_relationType" value="1" />
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="Attr_TraceLink_rationale" name="rationale" type="PT_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Low_TraceLink_rationale" value="0" />
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Up_TraceLink_rationale" value="1" />
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="Attr_TraceLink_confidence" name="confidence" type="PT_Real">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Low_TraceLink_confidence" value="0" />
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Up_TraceLink_confidence" value="1" />
        </ownedAttribute>
        <ownedRule xmi:type="uml:Constraint" xmi:id="C03_TraceDifferentRows" name="C03_TraceDifferentRows">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="C03_TraceDifferentRows_Spec">
            <language>OCL</language>
            <body>self.sourceStandard &lt;&gt; self.targetStandard</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="C04_TraceCrossFamily" name="C04_TraceCrossFamily">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="C04_TraceCrossFamily_Spec">
            <language>OCL</language>
            <body>self.sourceStandard.standardFamily &lt;&gt; self.targetStandard.standardFamily</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="C05_ConfidenceRange" name="C05_ConfidenceRange">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="C05_ConfidenceRange_Spec">
            <language>OCL</language>
            <body>self.confidence.oclIsUndefined() or (self.confidence &gt;= 0.0 and self.confidence &lt;= 1.0)</body>
          </specification>
        </ownedRule>
      </packagedElement>
