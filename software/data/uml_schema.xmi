          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Up_EvidenceItem_value" value="1" />
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="Attr_EvidenceItem_observedAt" name="observedAt" type="PT_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Low_EvidenceItem_observedAt" value="0" />
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Up_EvidenceItem_observedAt" value="1" />
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="Attr_EvidenceItem_sourceRef" name="sourceRef" type="PT_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Low_EvidenceItem_sourceRef" value="0" />
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Up_EvidenceItem_sourceRef" value="1" />
