          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Up_StandardRow_standardFamily" value="1" />
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="Attr_StandardRow_title" name="title" type="PT_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Low_StandardRow_title" value="1" />
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Up_StandardRow_title" value="1" />
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="Attr_StandardRow_evidenceStatus" name="evidenceStatus" type="Enum_EvidenceStatus">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Low_StandardRow_evidenceStatus" value="0" />
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Up_StandardRow_evidenceStatus" value="1" />
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="Attr_StandardRow_semanticStatus" name="semanticStatus" type="Enum_MappingStatus">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Low_StandardRow_semanticStatus" value="0" />
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="Up_StandardRow_semanticStatus" value="1" />
        </ownedAttribute>
        <ownedRule xmi:type="uml:Constraint" xmi:id="C01_UniqueStandardRowId" name="C01_UniqueStandardRowId">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="C01_UniqueStandardRowId_Spec">
            <language>OCL</language>
            <body>StandardRow.allInstances()-&gt;isUnique(rowId)</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="C02_UniqueStandardKey" name="C02_UniqueStandardKey">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="C02_UniqueStandardKey_Spec">
            <language>OCL</language>
            <body>StandardRow.allInstances()-&gt;isUnique(r | Tuple{family=r.standardFamily, id=r.standardId})</body>
          </specification>
        </ownedRule>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="Class_GQMGoal" name="GQMGoal">
