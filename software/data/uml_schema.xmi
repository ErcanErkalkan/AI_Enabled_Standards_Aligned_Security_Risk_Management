        <ownedAttribute xmi:type="uml:Property" xmi:id="Attr_EvidenceItem_evidenceStatus" name="evidenceStatus" type="Enum_EvidenceStatus">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="Low_EvidenceItem_evidenceStatus" value="1" />
