        </ownedAttribute>
        <ownedRule xmi:type="uml:Constraint" xmi:id="C06_EvidenceSourceRequired" name="C06_EvidenceSourceRequired">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="C06_EvidenceSourceRequired_Spec">
            <language>OCL</language>
            <body>(self.evidenceStatus = EvidenceStatus::telemetryLinked or self.evidenceStatus = EvidenceStatus::externallySupplied) implies (not self.sourceRef.oclIsUndefined() and self.sourceRef.size() &gt; 0)</body>
          </specification>
        </ownedRule>
      </packagedElement>
